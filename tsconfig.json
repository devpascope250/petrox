{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "prisma", "generated", "tests", "vitest.config.ts", "sidebar-flat.json"],
  "exclude": ["dist", "node_modules"]
}
