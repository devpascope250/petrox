NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL="postgresql://petrox:petrox@12139238ii321D@127.0.0.1:5432/petrox"
JWT_SECRET=replace-with-at-least-32-random-characters
PIN_HMAC_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Production: CORS_ORIGIN=https://app.ikwim.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Public address of this server; the POS gets file links as STATIC_URL/uploads/…
STATIC_URL=https://petrox.example.com

# Database backups (docs/backups.md). Without the key, backups are off.
# Generate once with: openssl rand -base64 32 — and keep a copy OFF the server.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_ID=k1
# Outside the clone and never inside uploads/ (served publicly).
BACKUP_DIR=/home/ikwim-api/backups
BACKUP_RETENTION_DAYS=14
# Rwanda time of the nightly backup; empty switches it off.
BACKUP_DAILY_AT=02:00
MYSQLDUMP_PATH=mysqldump
# Largest backup (MB) that may be uploaded to be decrypted on the web.
BACKUP_DECRYPT_MAX_MB=512
