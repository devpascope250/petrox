<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to <%= companyName %></title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #eff6ff;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #eff6ff;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
                    
                    <!-- Welcome Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 40px 30px; text-align: center;">
                            <div style="font-size: 60px; margin-bottom: 15px;">🎉</div>
                            <h1 style="color: #ffffff; font-size: 32px; margin: 0; font-weight: 700;">Welcome to <%= companyName %>!</h1>
                            <p style="color: rgba(255,255,255,0.9); font-size: 16px; margin: 10px 0 0 0;">We're thrilled to have you on board</p>
                        </td>
                    </tr>
                    
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 30px;">
                            <p style="color: #444444; font-size: 16px; line-height: 24px; margin: 0 0 20px 0;">
                                Hi <%= userName %>,
                            </p>
                            <p style="color: #666666; font-size: 15px; line-height: 24px; margin: 0 0 25px 0;">
                                Thank you for creating an account with <%= companyName %>! We're excited to have you join our community. Your account has been successfully created and you're all set to get started.
                            </p>
                            
                            <!-- Quick Start Button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 30px;">
                                <tr>
                                    <td align="center">
                                        <a href="<%= dashboardLink %>" 
                                           style="display: inline-block; padding: 16px 40px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #ffffff; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: 600; letter-spacing: 0.5px; box-shadow: 0 4px 12px rgba(102,126,234,0.3);">
                                            Go to Your Dashboard
                                        </a>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- Features Grid -->
                            <div style="margin-bottom: 30px;">
                                <h3 style="color: #333333; font-size: 18px; margin: 0 0 20px 0; font-weight: 600;">🚀 Quick Start Guide</h3>
                                
                                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                    <tr>
                                        <td style="padding: 15px; background-color: #f0f9ff; border-radius: 8px; margin-bottom: 10px;">
                                            <p style="color: #0369a1; font-size: 14px; margin: 0; font-weight: 600;">📋 Complete Your Profile</p>
                                            <p style="color: #666666; font-size: 13px; margin: 5px 0 0 0;">Add your details to personalize your experience</p>
                                        </td>
                                    </tr>
                                    <tr><td style="height: 10px;"></td></tr>
                                    <tr>
                                        <td style="padding: 15px; background-color: #f0fdf4; border-radius: 8px;">
                                            <p style="color: #166534; font-size: 14px; margin: 0; font-weight: 600;">🔍 Explore Features</p>
                                            <p style="color: #666666; font-size: 13px; margin: 5px 0 0 0;">Discover all the tools available to you</p>
                                        </td>
                                    </tr>
                                    <tr><td style="height: 10px;"></td></tr>
                                    <tr>
                                        <td style="padding: 15px; background-color: #fef3c7; border-radius: 8px;">
                                            <p style="color: #92400e; font-size: 14px; margin: 0; font-weight: 600;">📚 Check Our Resources</p>
                                            <p style="color: #666666; font-size: 13px; margin: 5px 0 0 0;">Access tutorials, guides, and documentation</p>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            
                            <!-- Account Details -->
                            <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 25px;">
                                <h3 style="color: #333333; font-size: 16px; margin: 0 0 15px 0; font-weight: 600;">📧 Your Account Details</h3>
                                <table role="presentation" cellspacing="0" cellpadding="5" border="0" width="100%">
                                    <tr>
                                        <td style="color: #666666; font-size: 13px;">Email:</td>
                                        <td style="color: #333333; font-size: 13px; font-weight: 500;"><%= userEmail %></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #666666; font-size: 13px;">Account Type:</td>
                                        <td style="color: #333333; font-size: 13px; font-weight: 500;">
                                            <span style="background-color: #dbeafe; color: #1e40af; padding: 3px 10px; border-radius: 12px; font-size: 12px;">
                                                <%= accountType %>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="color: #666666; font-size: 13px;">Member Since:</td>
                                        <td style="color: #333333; font-size: 13px; font-weight: 500;"><%= registrationDate %></td>
                                    </tr>
                                </table>
                            </div>
                            
                            <!-- Social Links -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 20px;">
                                <tr>
                                    <td style="text-align: center; padding: 15px 0;">
                                        <p style="color: #666666; font-size: 14px; margin: 0 0 15px 0;">Follow us for updates and tips:</p>
                                        <a href="<%= socialLinks.twitter %>" style="text-decoration: none; margin: 0 8px; color: #1DA1F2; font-size: 14px;">Twitter</a>
                                        <a href="<%= socialLinks.facebook %>" style="text-decoration: none; margin: 0 8px; color: #4267B2; font-size: 14px;">Facebook</a>
                                        <a href="<%= socialLinks.linkedin %>" style="text-decoration: none; margin: 0 8px; color: #0077B5; font-size: 14px;">LinkedIn</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f8f9fa; padding: 25px 30px; text-align: center; border-top: 1px solid #e9ecef;">
                            <p style="color: #999999; font-size: 12px; line-height: 18px; margin: 0 0 5px 0;">
                                &copy; <%= currentYear %> <%= companyName %>. All rights reserved.
                            </p>
                            <p style="color: #999999; font-size: 12px; line-height: 18px; margin: 0 0 5px 0;">
                                <a href="<%= unsubscribeLink %>" style="color: #667eea; text-decoration: none;">Unsubscribe</a> | 
                                <a href="<%= privacyPolicyLink %>" style="color: #667eea; text-decoration: none;">Privacy Policy</a>
                            </p>
                            <p style="color: #999999; font-size: 11px; line-height: 18px; margin: 10px 0 0 0;">
                                <%= companyAddress %>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>