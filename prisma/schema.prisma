model GeneralTransaction {
  id                         String                      @id @default(uuid())
  transactionCode            String                      @unique
  itemId                     String
  item                       Item                        @relation(fields: [itemId], references: [id])
  cuveId                     String
  cuve                       TblCuve                     @relation(fields: [cuveId], references: [id])
  pumpId                     String
  pump                       TblPump                     @relation(fields: [pumpId], references: [id])
  nozzleId                   String
  nozzle                     TblNozzle                   @relation(fields: [nozzleId], references: [id])
  clientId                   String?
  client                     Client?                     @relation(fields: [clientId], references: [id])
  cardCopyId                 BigInt?
  cardCopy                   CardCopy?                   @relation(fields: [cardCopyId], references: [id])
  platNumber                 String?
  platePictureUrl            String?
  quantity                   Decimal                     @default(0.0) @db.Decimal(18, 2)
  unitPrice                  Decimal                     @default(0.0) @db.Decimal(18, 2)
  amount                     Decimal                     @default(0.0) @db.Decimal(18, 2)
  siteId                     String
  site                       TblSite                     @relation(fields: [siteId], references: [id])
  discountAmount             Decimal                     @default(0.0) @db.Decimal(18, 2)
  shiftId                    String?
  shift                      TblShiftSite?               @relation(fields: [shiftId], references: [id])
  displayPictureUrl          String?
  doneBy                     String?
  user                       User?                       @relation(fields: [doneBy], references: [id])
  reason                     String?
  comments                   String?
  printStatus                Boolean                     @default(false)
  appVersion                 String?
  subsidyRate                Decimal                     @default(0.0) @db.Decimal(12, 2)
  subsidyAmount              Decimal                     @default(0.0) @db.Decimal(18, 2)
  /// initiated by the POS, then confirmed once (or cancelled).
  status                     GeneralTransactionStatus    @default(initiated)
  confirmedAt                DateTime?
  /// The POS that recorded it.
  deviceId                   String?
  device                     SiteDevice?                 @relation(fields: [deviceId], references: [id])
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  generalTransactionPayments GeneralTransactionPayment[]
  /// The tank ledger row written when the sale is confirmed.
  cuveTransaction            CuveTransaction?

  @@index([siteId, createdAt])
  @@index([siteId, id])
  @@index([status])
}

enum GeneralTransactionStatus {
  initiated
  confirmed
  cancelled
}

model GeneralTransactionPayment {
  id              String             @id @default(cuid())
  transactionId   String
  transaction     GeneralTransaction @relation(fields: [transactionId], references: [id])
  accountId       String
  account         CompanyAccount     @relation(fields: [accountId], references: [id])
  amount          Decimal            @db.Decimal(18, 2)
  /// The mobile-money / bank / card reference. Required when the account's
  /// `requiredReference` is on.
  reference       String?
  referenceDocUrl String?
  createdAt       DateTime           @default(now())

  @@unique([transactionId, accountId])
  @@index([transactionId])
  @@index([accountId])
}

enum BackupStatus {
  queued
  running
  completed
  failed
  /// The file was deleted: its retention ran out, or someone removed it.
  expired
}

enum BackupTrigger {
  manual
  scheduled
}

/// A database backup: the job and, once done, the encrypted file it produced.
/// The row stays after the file is gone, as a record of who made and fetched it.
model Backup {
  id               String        @id @default(uuid())
  status           BackupStatus  @default(queued)
  trigger          BackupTrigger @default(manual)
  /// The file's name inside BACKUP_DIR; never a path or a URL.
  fileName         String?
  sizeBytes        BigInt?
  /// SHA-256 of the encrypted file, to check a download arrived whole.
  sha256           String?       @db.Char(64)
  /// Which encryption key sealed it (BACKUP_KEY_ID at the time).
  keyId            String?
  error            String?       @db.Text
  /// Who asked for it; empty for a nightly backup.
  createdBy        String?
  creator          User?         @relation("BackupCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  /// When the file is deleted.
  expiresAt        DateTime?
  downloadCount    Int           @default(0)
  lastDownloadedAt DateTime?
  lastDownloadedBy String?
  lastDownloader   User?         @relation("BackupDownloader", fields: [lastDownloadedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdBy])
  @@index([lastDownloadedBy])
}
