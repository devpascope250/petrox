generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  isFixed     Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
  authorizers Authorizers[]
}

model CompanySettings {
  id          String   @id @default(uuid())
  companyName String   @default("")
  address     String?
  phone       String?
  email       String?
  taxId       String?
  currency    String   @default("USD")
  logoPath    String?
  updatedAt   DateTime @updatedAt
}

model Module {
  id          String       @id @default(uuid())
  name        String
  icon        String?
  code        String       @unique
  parentId    String?
  parent      Module?      @relation("ModuleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Module[]     @relation("ModuleHierarchy")
  sorting     Int          @default(0)
  createdAt   DateTime     @default(now())
  permissions Permission[]

  @@index([parentId])
}

model Permission {
  id              String           @id @default(uuid())
  moduleId        String
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@index([moduleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("RolePermissions")
}

model User {
  id                         String                   @id @default(uuid())
  email                      String                   @unique
  passwordHash               String
  pinHash                    String?
  firstName                  String
  lastName                   String
  phone                      String?
  roleId                     String?
  role                       Role?                    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive                   Boolean                  @default(true)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  clientId                   String?
  siteId                     String?
  position                   UserPositions            @default(siteManager)
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  orders                     Order[]
  lineLines                  NominationTimeLine[]
  stockTransactions          StockTransaction[]
  createdCentralStockOrders  CentralStockOrder[]      @relation("CentralStockOrderCreatedByUser")
  approvedCentralStockOrders CentralStockOrder[]      @relation("CentralStockOrderApprovedByUser")
  stockClearances            StockClearance[]
  client                     Client?                  @relation(fields: [clientId], references: [id])
  sites                      UserSites[]
  loadingOrderAuthorizers    LoadingOrderAuthorizer[]
  companyAccounts            CompanyAccount[]
  clientWallets              ClientWallet[]
  orderReceptions            OrderReception[]
  discounts                  Discount[]

  @@index([roleId])
}

enum UserPositions {
  superAdmin
  siteManager
  clientAdmin
  clientUser
}

model Client {
  id               String         @id @default(uuid())
  clientCode       String         @unique
  name             String?
  phone            String?
  email            String?
  idTino           String?
  province         String?
  proviceLocation  Location?      @relation("ProviceLocationsRef", fields: [province], references: [id], onDelete: SetNull)
  district         String?
  districtLocation Location?      @relation("DistrictLocationRef", fields: [district], references: [id], onDelete: SetNull)
  sector           String?
  sectorLocation   Location?      @relation("SectorLocationRef", fields: [sector], references: [id], onDelete: SetNull)
  status           Boolean        @default(true)
  subsidyAllowed   Boolean        @default(false)
  users            User[]
  clientWallets    ClientWallet[]
  cardCopies       CardCopy[]
  discounts        Discount[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
}

// phase 2 of impementing items

model Item {
  id           String     @id @default(uuid())
  name         String
  descriptions String?
  parentId     String?
  baseUnitId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       StatusType @default(active)

  baseUnit  Unit?      @relation(fields: [baseUnitId], references: [id], onDelete: SetNull)
  itemUnits ItemUnit[]

  itemClass     Item?          @relation("ItemHierarchy", fields: [parentId], references: [id])
  items         Item[]         @relation("ItemHierarchy")
  orders        Order[]
  stock         Stock[]
  centralStocks CentralStock[]
  cuves         TblCuve[]
  toleranceRates ItemToleranceRate[]

  @@index([id])
  @@index([parentId])
}

model Unit {
  id         String     @id @default(uuid())
  name       String
  code       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  status     StatusType @default(active)
  itemsUnits ItemUnit[]
  items      Item[]

  @@index([id])
}

model ItemUnit {
  id             String     @id @default(uuid())
  unitId         String
  itemId         String
  factorialValue Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  status         StatusType @default(active)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, itemId])
  @@index([id])
  @@index([unitId])
  @@index([itemId])
}

model Supplier {
  id             String       @id @default(uuid())
  name           String
  address        String?
  phone          String?
  tinNumber      String?
  supplierTypeId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  status         StatusType   @default(active)
  supplierType   SupplierType @relation(fields: [supplierTypeId], references: [id])
  orders         Order[]

  @@index([id])
  @@index([supplierTypeId])
}

model SupplierType {
  id        String     @id @default(uuid())
  type      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  status    StatusType @default(active)
  suppliers Supplier[]

  @@index([id])
}

enum StatusType {
  active
  inactive
}

// for orders and order plans

model OrderPlan {
  id        String     @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    PlanStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]

  @@index([id])
  @@index([startDate, endDate])
  @@index([status])
}

enum PlanStatus {
  active
  closed
  terminated
  force_closed
}

model Order {
  id              String    @id @default(uuid())
  orderCode       String    @unique
  supplierId      String
  orderDate       DateTime
  itemId          String
  createdByUserId String
  orderPlanId     String
  quantity        Decimal   @db.Decimal(18, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  plan            OrderPlan @relation(fields: [orderPlanId], references: [id])
  item            Item      @relation(fields: [itemId], references: [id])
  createdUser     User      @relation(fields: [createdByUserId], references: [id])
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  cargos          Cargo[]

  @@index([id])
  @@index([orderCode])
  @@index([supplierId])
  @@index([createdByUserId])
  @@index([orderPlanId])
  @@map("orders")
}

// moving to Deports

model Deport {
  id            String         @id @default(uuid())
  name          String
  type          DeportType     @default(local)
  location      String
  status        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  stocks        Stock[]
  cargos        Cargo[]
  centralStocks CentralStock[]

  @@index([id])
  @@index([status])
}

enum DeportType {
  local
  foreign
  international
}

model Transporter {
  id        String     @id @default(uuid())
  name      String
  phone     String
  address   String
  tinNumber String
  status    StatusType @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vehicles  Vehicle[]
  drivers   Driver[]

  @@index([id])
}

model Vehicle {
  id            String           @id @default(uuid())
  platNumber    String
  transporterId String
  transport     Transporter      @relation(fields: [transporterId], references: [id])
  truckNumber   String
  trailerNumber String
  model         String
  tankCapacity  Decimal          @db.Decimal(18, 2)
  status        StatusType       @default(active)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  drivers       DriverVehicles[]

  @@index([id])
  @@index([transporterId])
}

model Driver {
  id            String           @id @default(uuid())
  names         String
  phone         String
  lisence       String
  passport      String
  transporterId String
  transport     Transporter      @relation(fields: [transporterId], references: [id])
  status        StatusType       @default(active)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  vehicles      DriverVehicles[]

  @@index([id])
  @@index([transporterId])
}

model DriverVehicles {
  id            String              @id @default(uuid())
  driverId      String
  driver        Driver              @relation(fields: [driverId], references: [id])
  vehicleId     String
  vechile       Vehicle             @relation(fields: [vehicleId], references: [id])
  status        DriverVehicleStatus @default(active)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  nominations   Nomination[]
  loadingOrders LoadingOrder[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([driverId, vehicleId])
}

// driverVehicle status

enum DriverVehicleStatus {
  active
  inactive
  occupied
}

model LoadingOrder {
  id                  String                          @id @default(uuid())
  driverVehicleId     String
  totalQuantity       Decimal                         @db.Decimal(18, 2)
  authoriserCount     Int                             @default(1)
  status              LoadingOrderStatus              @default(pending)
  authorizationStatus LoadingOrderAuthorizationStatus @default(pending)
  dVehicle            DriverVehicles                  @relation(fields: [driverVehicleId], references: [id])
  authorizers         LoadingOrderAuthorizer[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  orderReceptions     OrderReception[]
  loadedOrders        LoadedOrder[]

  @@index([driverVehicleId])
}

model LoadedOrder {
  id             String            @id @default(uuid())
  orderId        String
  order          CentralStockOrder @relation(fields: [orderId], references: [id])
  loadingOrderId String
  loadingOrder   LoadingOrder      @relation(fields: [loadingOrderId], references: [id])
  quantity       Decimal           @db.Decimal(18, 2)
  createdAt      DateTime          @default(now())

  @@unique([loadingOrderId, orderId])
  @@index([orderId])
  @@index([loadingOrderId])
}

model OrderReception {
  id             String             @id @default(uuid())
  loadingOrderId String
  loadingOrder   LoadingOrder       @relation(fields: [loadingOrderId], references: [id])
  cuveId         String
  cuve           TblCuve            @relation(fields: [cuveId], references: [id])
  expectedQty    Decimal            @db.Decimal
  receivedQty    Decimal            @db.Decimal
  receivedBy     String
  status         LoadingOrderStatus @default(pending)
  user           User               @relation(fields: [receivedBy], references: [id])
  createdAt      DateTime           @default(now())

  @@index([loadingOrderId])
  @@index([cuveId])
}

enum LoadingOrderStatus {
  pending
  received
  cancelled
}

enum LoadingOrderAuthorizationStatus {
  pending
  approved
}

model LoadingOrderAuthorizer {
  id             String       @id @default(uuid())
  loadingOrderId String
  loadingOrder   LoadingOrder @relation(fields: [loadingOrderId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], map: "fk_loading_order_authorizer_user")
  authorizerId   String
  authorizer     Authorizers  @relation(fields: [authorizerId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([loadingOrderId, userId])
  @@unique([loadingOrderId, authorizerId])
  @@index([loadingOrderId])
  @@index([userId])
  @@index([authorizerId])
}

model Authorizers {
  id        String                   @id @default(uuid())
  type      AuthoriserType
  levels    Int                      @default(1)
  roleId    String
  status    StatusType               @default(active)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  role      Role                     @relation(fields: [roleId], references: [id])
  approvals LoadingOrderAuthorizer[]

  @@unique([type, roleId])
  @@index([roleId])
}

enum AuthoriserType {
  LOADING_ORDER
}

// moving to cargo

model Cargo {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  deportId         String
  deport           Deport         @relation(fields: [deportId], references: [id])
  vesselName       String
  receivedDate     DateTime
  expirationDate   DateTime
  ambQuantity      Decimal        @default(0.0) @db.Decimal(18, 2)
  quantityAt20C    Decimal        @default(0.0) @db.Decimal(18, 2)
  blRef            String
  supportingDocUrl String?
  tansisRef        String?
  outurnRef        String?
  status           CargoStatus    @default(pending)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  stocks           Stock[]
  cargoInvoices    CargoInvoice[]

  @@index([orderId])
  @@index([blRef])
  @@index([tansisRef])
  @@index([receivedDate])
  @@index([status])
}

model Stock {
  id           String       @id @default(uuid())
  deportId     String
  deport       Deport       @relation(fields: [deportId], references: [id])
  cargoId      String
  cargo        Cargo        @relation(fields: [cargoId], references: [id])
  itemId       String
  item         Item         @relation(fields: [itemId], references: [id])
  quantity     Decimal      @db.Decimal(18, 2)
  receivedDate DateTime
  status       StockStatus  @default(awaiting)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  nominations  Nomination[]

  @@index([deportId])
  @@index([cargoId])
  @@index([status])
}

enum StockStatus {
  awaiting
  cancelled
  returned
  received
}

enum CargoStatus {
  pending
  approved
  cancelled
}

model Nomination {
  id                  String               @id @default(uuid())
  stockId             String
  stock               Stock                @relation(fields: [stockId], references: [id])
  driverVehicleId     String
  driverVehicle       DriverVehicles       @relation(fields: [driverVehicleId], references: [id])
  ambQuantity         Decimal              @default(0.0) @db.Decimal(18, 2)
  quantityAt20C       Decimal              @default(0.0) @db.Decimal(18, 2)
  destination         String
  expectedLoadingDate DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  pfis                Pfi[]
  timeLine            NominationTimeLine[]
  t1Validations       T1Validation[]

  @@index([stockId])
  @@index([driverVehicleId])
}

model Currency {
  id        String   @id @default(uuid())
  code      String
  name      String
  rate      Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pifs      Pfi[]
}

model Pfi {
  id               String     @id @default(uuid())
  currencyId       String
  currency         Currency   @relation(fields: [currencyId], references: [id])
  nominationId     String
  nomination       Nomination @relation(fields: [nominationId], references: [id])
  currancyCode     String
  unitPrice        Decimal    @db.Decimal(12, 2)
  amount           Decimal    @db.Decimal(18, 2)
  supportingDocUrl String?
  pifCode          String     @unique
  pfiReference     String     @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([nominationId])
  @@index([id])
}

model NominationTimeLine {
  id               String                   @id @default(uuid())
  nominationId     String
  nomination       Nomination               @relation(fields: [nominationId], references: [id])
  timeLineStatusId String
  timeLineStatus   NominationTimeLineStatus @relation(fields: [timeLineStatusId], references: [id])
  changedBy        String?
  user             User?                    @relation(fields: [changedBy], references: [id])
  descriptions     String?
  createdAt        DateTime                 @default(now())

  @@index([nominationId])
  @@index([timeLineStatusId])
}

model NominationTimeLineStatus {
  id           String               @id @default(uuid())
  status       TimeLineStatus       @unique
  level        Int
  descriptions String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  timeLines    NominationTimeLine[]

  @@index([status])
}

enum TimeLineStatus {
  awaiting
  underLoading
  t1Pending
  t1Confirmed
  stockReceived
}

model T1Validation {
  id               String     @id @default(uuid())
  nominationId     String     @unique
  nomination       Nomination @relation(fields: [nominationId], references: [id])
  exportingCountry String
  supportingDocUrl String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  extraValidations ExtraT1Validation[]

  centralStocks CentralStock[]

  @@index([nominationId])
  @@index([id])
}

model ExtraT1Validation {
  id               String                  @id @default(uuid())
  t1ValidationId   String
  validation       T1Validation            @relation(fields: [t1ValidationId], references: [id])
  customOffice     String
  transitNumbering String
  status           ExtraT1ValidationStatus @default(pending)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([t1ValidationId])
}

enum ExtraT1ValidationStatus {
  pending
  cancelled
  confirmed
}

model CentralStock {
  id                 String              @id @default(uuid())
  deportId           String
  deport             Deport              @relation(fields: [deportId], references: [id])
  itemId             String
  item               Item                @relation(fields: [itemId], references: [id])
  ambQuantity      Decimal        @default(0.0) @db.Decimal(18, 2)
  quantityAt20C    Decimal        @default(0.0) @db.Decimal(18, 2)
  supportingDocUrl   String?
  t1ValidationId     String
  t1Validation       T1Validation        @relation(fields: [t1ValidationId], references: [id])
  status             CentralStockStatus  @default(inStock)
  toleranceRate      Decimal?             @db.Decimal(12, 2)
  lossQty            Decimal?             @db.Decimal(18, 2)
  gainQty            Decimal?             @db.Decimal(18, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  stockClearances    StockClearance[]
  transactions       StockTransaction[]
  centralStockOrders CentralStockOrder[]

  @@index([id])
  @@index([deportId])
  @@index([itemId])
  @@index([t1ValidationId])
  @@index([status])
}

enum CentralStockStatus {
  inStock
  stockOut
}

model StockTransaction {
  id               String               @id @default(uuid())
  centralStockId   String
  centralStock     CentralStock         @relation(fields: [centralStockId], references: [id])
  quantity         Decimal              @db.Decimal(18, 2)
  note             String?
  supportingDocUrl String?
  type             StockTransactionType
  createdBy        String
  user             User                 @relation(fields: [createdBy], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([id])
  @@index([centralStockId])
}

model StockClearance {
  id                 String              @id @default(uuid())
  centralStockId     String
  centralStock       CentralStock        @relation(fields: [centralStockId], references: [id])
  quantity           Decimal             @db.Decimal(18, 2)
  fees               Decimal?            @db.Decimal(18, 2)
  amount             Decimal?            @db.Decimal(18, 2)
  status             StockStateStatus    @default(uncleared)
  clearedBy          String?
  user               User?               @relation(fields: [clearedBy], references: [id])
  agentId            String?
  agent              ClearingAgent?      @relation(fields: [agentId], references: [id])
  supportingDocUrl   String?
  dmsDocUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  centralStockOrders CentralStockOrder[]

  @@index([id])
  @@index([centralStockId])
}

model ClearingAgent {
  id              String           @id @default(uuid())
  names           String
  fees            Decimal          @db.Decimal(18, 2)
  status          StatusType       @default(active)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  stockClearances StockClearance[]
}

enum StockStateStatus {
  cleared
  uncleared
}

enum StockTransactionType {
  saleOut
  reconcilliationIn
  reconcilliationOut
  received
}

model CentralStockOrder {
  id             String                @id @default(uuid())
  siteId         String?
  site           TblSite?              @relation(fields: [siteId], references: [id])
  clearanceId    String
  clearance      StockClearance        @relation(fields: [clearanceId], references: [id])
  centralStockId String
  centralStock   CentralStock          @relation(fields: [centralStockId], references: [id])
  orderType      CentralStockOrderType
  quantity       Decimal               @db.Decimal(18, 2)
  unitPrice      Decimal               @db.Decimal(18, 2)
  totalPrice     Decimal               @db.Decimal(18, 2)
  createdBy      String
  user           User                  @relation("CentralStockOrderCreatedByUser", fields: [createdBy], references: [id])
  approvedBy     String?
  approvedUser   User?                 @relation("CentralStockOrderApprovedByUser", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  status         CentralOrderStatus    @default(pending)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  loadedOrders   LoadedOrder[]

  @@index([centralStockId])
  @@index([clearanceId])
}

enum CentralStockOrderType {
  internal
  b2b
}

enum CentralOrderStatus {
  pending
  approved
  rejected
  cancelled
}

model TblSite {
  id                 String              @id @default(uuid())
  name               String
  phone              String?
  email              String?
  address            String?
  status             StatusType          @default(active)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  pumps              TblPump[]
  tblCuves           TblCuve[]
  centralStockOrders CentralStockOrder[]
  users              UserSites[]
  discounts          Discount[]
  rangingDiscounts   RangingDiscount[]

  @@index([id])
}

model UserSites {
  id        String     @id @default(uuid())
  userId    String
  siteId    String
  status    StatusType @default(active)
  createdAt DateTime   @default(now())
  updated   DateTime   @updatedAt

  user User    @relation(fields: [userId], references: [id])
  site TblSite @relation(fields: [siteId], references: [id])

  @@unique([userId, siteId])
}

model TblCuve {
  id        String     @id @default(uuid())
  name      String
  siteId    String
  site      TblSite    @relation(fields: [siteId], references: [id])
  itemId    String
  item      Item       @relation(fields: [itemId], references: [id])
  minimum   Decimal    @db.Decimal(18, 2)
  maximum   Decimal    @db.Decimal(18, 2)
  deadStock Decimal    @db.Decimal(18, 2)
  status    StatusType @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  nozzles         TblNozzle[]
  orderReceptions OrderReception[]

  @@index([id])
  @@index([siteId])
}

model TblPump {
  id        String       @id @default(uuid())
  name      String
  siteId    String
  site      TblSite      @relation(fields: [siteId], references: [id])
  status    StatusType   @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  displays  TblDisplay[]
  nozzles   TblNozzle[]

  @@index([id])
  @@index([siteId])
}

model TblDisplay {
  id        String      @id @default(uuid())
  name      String
  code      String
  pumpId    String
  pump      TblPump     @relation(fields: [pumpId], references: [id])
  status    StatusType  @default(active)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  nozzles   TblNozzle[]

  @@index([id])
  @@index([pumpId])
}

model TblNozzle {
  id         String     @id @default(uuid())
  name       String
  nozzleCode String
  pumpId     String
  pump       TblPump    @relation(fields: [pumpId], references: [id])
  displayId  String
  display    TblDisplay @relation(fields: [displayId], references: [id])
  cuveId     String
  cuve       TblCuve    @relation(fields: [cuveId], references: [id])
  status     StatusType @default(active)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([id])
  @@index([pumpId])
  @@index([displayId])
  @@index([cuveId])
}

model Location {
  id   String @id @default(uuid())
  name String

  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent          Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Location[] @relation("LocationHierarchy")
  clientProvinces Client[]   @relation("ProviceLocationsRef")
  clientDistricts Client[]   @relation("DistrictLocationRef")
  clientSectors   Client[]   @relation("SectorLocationRef")

  @@index([parentId])
}

model CompanyAccount {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  status      StatusType @default(active)
  createdAtBy String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user               User                @relation(fields: [createdAtBy], references: [id])
  walletTransactions walletTransaction[]
}

model ClientWallet {
  id                 String              @id @default(cuid())
  amount             Decimal             @default(0.0) @db.Decimal(18, 2)
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id])
  createdAtBy        String
  status             StatusType          @default(active)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [createdAtBy], references: [id])
  walletTransactions walletTransaction[]
}

model walletTransaction {
  id               String                         @id @default(uuid())
  clientWalletId   String
  wallet           ClientWallet                   @relation(fields: [clientWalletId], references: [id])
  accountId        String?
  account          CompanyAccount?                @relation(fields: [accountId], references: [id])
  referenceId      String?
  type             WalletTransactionType
  direction        WalletTransactionDirectionType
  supportingDocUrl String?
  amount           Decimal                        @db.Decimal(18, 2)
  createdAt        DateTime                       @default(now())
}

enum WalletTransactionDirectionType {
  IN
  OUT
}

enum WalletTransactionType {
  DEPOSIT
  PAYMENT
  REFUND
  LOAN
  WITHDRAWAL
  TRANSFER
  ADJUSTMENT
}

model Card {
  id BigInt @id @default(autoincrement())
  // `security_category` int(255) DEFAULT NULL COMMENT '1=Ordinary 2=Specific',
  // `state` tinyint(1) NOT NULL DEFAULT 1 COMMENT '1 = ready,\r\n0 = busy,\r\n2="card is Blocked"',
  // `swap_status` int(11) DEFAULT NULL COMMENT '1=used for swap',
  // `inventory_status` int(255) DEFAULT NULL COMMENT '1="in stock",2="sent to the site" 3="assignrd to the client"',
  // `updatedAt` date DEFAULT NULL COMMENT 'when we block card this will help to know when ',

  cardNumber       String?   @unique
  serialNumber     String?   @unique
  cardCode         String?
  balance          Decimal   @default(0.0) @db.Decimal(18, 2)
  availability     Boolean   @default(true)
  type             CardType?
  // COMMENT '1=Ordinary 2=Specific',
  securityCategory Int?
  state            Int       @default(1)
  swapStatus       Int?
  inventoryStatus  Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  originalCards CardCopy[] @relation("originalCards")
  copyCards     CardCopy[] @relation("copyCardFromCard")
}

enum CardType {
  prePaid
  postPaid
  master
  royalty
}

model CardCopy {
  id         BigInt   @id @default(autoincrement())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  cardId     BigInt
  card       Card     @relation("originalCards", fields: [cardId], references: [id])
  cardCopyId BigInt?
  copyCard   Card?    @relation("copyCardFromCard", fields: [cardCopyId], references: [id])
  lastIndex  Int      @default(1)
  pin        String
  status     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Discount {
  id        String       @id @default(uuid())
  type      DiscountType
  value     Decimal      @db.Decimal(12, 1)
  status    StatusType   @default(active)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id])
  siteId    String?
  site      TblSite?     @relation(fields: [siteId], references: [id])
  validFrom DateTime
  validTo   DateTime
  createdBy String
  user      User         @relation(fields: [createdBy], references: [id])
  createdAt DateTime     @default(now())

  rangingDiscounts RangingDiscount[]
}

enum DiscountType {
  fixed
  ranging
}

model RangingDiscount {
  id         String     @id @default(uuid())
  from       Decimal    @db.Decimal(12, 1)
  to         Decimal    @db.Decimal(12, 1)
  amount     Decimal    @db.Decimal(12, 1)
  discountId String
  discount   Discount   @relation(fields: [discountId], references: [id])
  siteId     String
  site       TblSite    @relation(fields: [siteId], references: [id])
  status     StatusType
  createdAt  DateTime   @default(now())
}

model CargoInvoice {
  id               String   @id @default(uuid())
  quantity         Decimal  @db.Decimal(18, 2)
  unitPrice        Decimal  @db.Decimal(18, 2)
  amount           Decimal  @db.Decimal(18, 2)
  currencyCode     String
  cargoId          String
  cargo            Cargo    @relation(fields: [cargoId], references: [id])
  supportingDocUrl String?
  invoiceCode      String   @unique
  invoiceReference String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ItemToleranceRate {
  id       String   @id @default(uuid())
  maxRate     Decimal  @db.Decimal(12, 2)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  status    StatusType @default(active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}