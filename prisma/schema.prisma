generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id String @id @default(uuid())
  name String @unique
  isFixed Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  permissions RolePermission[]
}

model CompanySettings {
  id String @id @default(uuid())
  companyName String @default("")
  address String?
  phone String?
  email String?
  taxId String?
  currency String @default("USD")
  logoPath String?
  updatedAt DateTime @updatedAt
}

model Module {
  id String @id @default(uuid())
  name String
  icon String?
  code String @unique
  parentId String?
  parent Module? @relation("ModuleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Module[] @relation("ModuleHierarchy")
  sorting Int @default(0)
  createdAt DateTime @default(now())
  permissions Permission[]
  @@index([parentId])
}

model Permission {
  id String @id @default(uuid())
  moduleId String
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name String
  code String @unique
  description String?
  createdAt DateTime @default(now())
  rolePermissions RolePermission[]
  @@index([moduleId])
}

model RolePermission {
  id String @id @default(uuid())
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("RolePermissions")
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  pinHash String?
  firstName String
  lastName String
  phone String?
  roleId String?
  role Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  orders  Order[]
  @@index([roleId])
}

model RefreshToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  @@index([userId])
}

model PasswordResetToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt DateTime?
  @@index([userId])
}


// phase 2 of impementing items

model Item {
  id  String @id @default(uuid())
  name String
  descriptions String?
  parentId  String?
  baseUnitId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  status    StatusType @default(active)

  baseUnit Unit? @relation(fields: [baseUnitId], references: [id], onDelete: SetNull)
  itemUnits ItemUnit[]

  itemClass Item? @relation("ItemHierarchy", fields: [parentId], references: [id])
  items     Item[] @relation("ItemHierarchy")
  orders    Order[]

  @@index([id])
  @@index([parentId])
}

model Unit {
  id  String  @id @default(uuid())
  name String
  code String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status   StatusType @default(active)
  itemsUnits ItemUnit[]
  items  Item[]

  @@index([id])
}


model ItemUnit {
  id      String   @id  @default(uuid())
  unitId  String
  itemId  String
  factorialValue Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  status     StatusType @default(active)

  item  Item @relation(fields: [itemId], references: [id],onDelete: Cascade)
  unit  Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, itemId])
  @@index([id])
  @@index([unitId])
  @@index([itemId])

}


model Supplier {
  id   String  @id @default(uuid())
  name String
  address String?
  phone   String?
  tinNumber String?
  supplierTypeId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  status       StatusType @default(active)
  supplierType SupplierType @relation(fields: [supplierTypeId], references: [id])
  orders        Order[]
  @@index([id])
  @@index([supplierTypeId])
}


model SupplierType {
  id    String   @id @default(uuid())
  type  String
  createdAt DateTime @default(now())
  updatedAt  DateTime @default(now())
  status     StatusType @default(active)
  suppliers   Supplier[]

  @@index([id])
}

enum StatusType {
  active
  inactive
}

// for orders and order plans

model OrderPlan {
  id  String    @id @default(uuid())
  name    String
  startDate DateTime
  endDate   DateTime
  status    PlanStatus @default(active)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
  
  @@index([id])
  @@index([startDate, endDate])
  @@index([status])
}


enum PlanStatus {
  active
  closed
  terminated
  force_closed
}

model Order {
  id   String @id @default(uuid())
  orderCode  String @unique
  supplierId  String
  orderDate   DateTime
  itemId      String
  createdByUserId   String
  orderPlanId  String
  quantity      Decimal @db.Decimal(18,2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  plan        OrderPlan @relation(fields: [orderPlanId], references: [id])
  item        Item @relation(fields: [itemId], references: [id])
  createdUser User @relation(fields: [createdByUserId], references: [id])
  supplier    Supplier @relation(fields: [supplierId], references: [id])


  @@index([id])
  @@index([orderCode])
  @@index([supplierId])
  @@index([createdByUserId])
  @@index([orderPlanId])
}