  copyCard                 Card?                     @relation("copyCardFromCard", fields: [cardCopyId], references: [id])
  lastIndex                Int                       @default(1)
  // Assigned as 123456 (DEFAULT_CARD_PIN); older rows may have none.
  pin                      String?
  status                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  cardCopyTransactions     CardCopyTransaction[]
  clientCarCardAssignments ClientCarCardAssignment[]
  generalTransactions      GeneralTransaction[]

  @@index([clientId])
  @@index([cardId])
  @@index([cardCopyId])
}

model CardCopyTransaction {
