  parent          Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Location[] @relation("LocationHierarchy")
  clientProvinces Client[]   @relation("ProviceLocationsRef")
  clientDistricts Client[]   @relation("DistrictLocationRef")
  clientSectors   Client[]   @relation("SectorLocationRef")

  @@index([parentId])
