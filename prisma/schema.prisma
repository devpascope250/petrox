  value     Decimal      @db.Decimal(12, 1)
  status    StatusType   @default(active)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id])
  siteId    String?
  site      TblSite?     @relation(fields: [siteId], references: [id])
  validFrom DateTime
  validTo   DateTime
  createdBy String
  user      User         @relation(fields: [createdBy], references: [id])
  createdAt DateTime     @default(now())

  rangingDiscounts    RangingDiscount[]
  /// The sales this discount priced; each keeps its own copy of the figures.
  fuelSales           FuelSale[]
  generalTransactions GeneralTransaction[]

  @@index([clientId])
  @@index([siteId])
}

enum DiscountType {
  fixed
  ranging
}

model RangingDiscount {
  id         String     @id @default(uuid())
  from       Decimal    @db.Decimal(12, 1)
  to         Decimal    @db.Decimal(12, 1)
  /// The **percentage** off a sale whose quantity falls in this band. The
  /// litres decide the band, they are not multiplied by the rate.
  rate       Decimal    @db.Decimal(12, 1)
  discountId String
  discount   Discount   @relation(fields: [discountId], references: [id])
  siteId     String
  site       TblSite    @relation(fields: [siteId], references: [id])
  status     StatusType
  createdAt  DateTime   @default(now())

  updatedAt DateTime? @updatedAt

  @@index([discountId])
  @@index([siteId])
}

model CargoInvoice {
  id               String   @id @default(uuid())
  quantity         Decimal  @db.Decimal(18, 2)
  unitPrice        Decimal  @db.Decimal(18, 2)
  amount           Decimal  @db.Decimal(18, 2)
  currencyCode     String
  cargoId          String
  cargo            Cargo    @relation(fields: [cargoId], references: [id])
  supportingDocUrl String?
  invoiceCode      String   @unique
  invoiceReference String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([cargoId])
}

model ItemToleranceRate {
  id        String     @id @default(uuid())
  maxRate   Decimal    @db.Decimal(12, 2)
  itemId    String
  item      Item       @relation(fields: [itemId], references: [id])
  status    StatusType @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([itemId])
}

model CouponPlan {
  id            String         @id @default(uuid())
  name          String
  number        Int
  amount        Decimal        @db.Decimal(18, 2)
  /// Days a coupon of this plan stays valid after it is issued; empty = never expires.
  validityDays  Int?
  status        StatusType     @default(active)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clientCoupons ClientCoupon[]

  @@index([id])
}

model ClientCoupon {
  id              String             @id @default(uuid())
  couponPlanId    String
  couponPlan      CouponPlan         @relation(fields: [couponPlanId], references: [id])
  clientId        String
  client          Client             @relation(fields: [clientId], references: [id])
  code            String             @unique
  token           String
  export          Boolean            @default(false)
  /// Face value: what the coupon was worth when issued.
  amount          Decimal            @db.Decimal(18, 2)
  /// What is left to spend; goes down with each redemption.
  remainingAmount Decimal            @db.Decimal(18, 2)
  generatedAt     DateTime           @default(now())
  printedAt       DateTime?
  scannedAt       DateTime?
  /// The paper coupon itself: issued, printed, or cancelled.
  status          ClientCouponStatus @default(available)
  /// How much of its value is spent.
  usage           ClientCouponUsage  @default(unused)
  /// After this it can no longer be spent; empty = never.
  expiresAt       DateTime?
  redemptions     CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([couponPlanId])
  @@index([clientId])
  @@index([code])
}

/// The paper coupon. How much of it is spent is `ClientCouponUsage`.
enum ClientCouponStatus {
  available
  printed
  cancelled
}

/// How much of a coupon's value is spent.
enum ClientCouponUsage {
  unused
  partiallyUsed
  used
  expired
}

/// One coupon spent, wholly or in part, on one POS sale.
model CouponRedemption {
  id                   String             @id @default(uuid())
  clientCouponId       String
  clientCoupon         ClientCoupon       @relation(fields: [clientCouponId], references: [id])
  generalTransactionId String
  generalTransaction   GeneralTransaction @relation(fields: [generalTransactionId], references: [id])
  siteId               String
  site                 TblSite            @relation(fields: [siteId], references: [id])
  /// What this sale took from the coupon.
  amount               Decimal            @db.Decimal(18, 2)
  /// The attendant who took it.
  redeemedBy           String
  user                 User               @relation("CouponRedeemer", fields: [redeemedBy], references: [id])
  createdAt            DateTime           @default(now())

  @@unique([clientCouponId, generalTransactionId])
  @@index([generalTransactionId])
  @@index([siteId])
  @@index([redeemedBy])
}

model TblShift {
  id            String         @id @default(uuid())
  name          String
  startAt       DateTime       @db.Time(0)
  endAt         DateTime       @db.Time(0)
  status        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tblShiftSites TblShiftSite[]
}

model TblShiftSite {
  id                  String               @id @default(uuid())
  shiftId             String
  shift               TblShift             @relation(fields: [shiftId], references: [id])
  siteId              String
  site                TblSite              @relation(fields: [siteId], references: [id])
  turnonAt            DateTime             @default(now())
  status              Int                  @default(1)
  tblPumpAttendants   TblPumpAttendant[]
  tblTimeTables       TblTimeTable[]
  fuelSales           FuelSale[]
  generalTransactions GeneralTransaction[]
  pumpIndexes         PumpIndex[]

  @@index([shiftId])
  @@index([siteId])
}

/// Which pump and nozzles an attendant handles in a site shift. Not which
/// days he works: the time table (`TblTimeTable`) rosters people by date, and
/// that is what a sale checks.
model TblPumpAttendant {
  id                   String                @id @default(uuid())
  pumpId               String
  pump                 TblPump               @relation(fields: [pumpId], references: [id])
  siteShiftId          String
  siteShift            TblShiftSite          @relation(fields: [siteShiftId], references: [id])
  userId               String
  user                 User                  @relation(fields: [userId], references: [id])
  siteId               String
  site                 TblSite               @relation(fields: [siteId], references: [id])
  createdAt            DateTime              @default(now())
  pumpAttendantNozzles PumpAttendantNozzle[]

  @@unique([userId, siteShiftId, pumpId])
  @@index([pumpId])
  @@index([siteShiftId])
  @@index([userId])
  @@index([siteId])
}

model PumpAttendantNozzle {
  id              String           @id @default(uuid())
  pumpAttendantId String
  pumpAttendant   TblPumpAttendant @relation(fields: [pumpAttendantId], references: [id])
  nozzleId        String
  nozzle          TblNozzle        @relation(fields: [nozzleId], references: [id])
  createdAt       DateTime         @default(now())

  @@unique([pumpAttendantId, nozzleId])
  @@index([pumpAttendantId])
}

model TblTimeTable {
  id          String       @id @default(uuid())
  days        Int
  dateOn      DateTime     @db.Date
  siteShiftId String
  shiftSite   TblShiftSite @relation(fields: [siteShiftId], references: [id])
  userId      String
  user        User         @relation("TimeTableUsers", fields: [userId], references: [id])
  siteId      String
  site        TblSite      @relation(fields: [siteId], references: [id])
  status      Int          @default(0)
  extraShift  Int          @default(0)
  createdAt   DateTime     @default(now())
  isChief     Boolean      @default(false)
  isSuport    Boolean      @default(false)

  @@index([siteShiftId])
  @@index([userId])
  @@index([siteId])
}

model ClientCar {
  id                       String                    @id @default(uuid())
  clientId                 String
  client                   Client                    @relation(fields: [clientId], references: [id])
  plateNo                  String
  trackNo                  String?
  itemId                   String
  item                     Item                      @relation(fields: [itemId], references: [id])
  tancapacity              Decimal                   @db.Decimal(18, 2)
  status                   StatusType                @default(active)
  /// Whether this car may earn the product's subsidy. The client must be
  /// allowed one as well, and the car must take the product being pumped: one
  /// allowed diesel earns nothing on a tank of petrol.
  subsidyAllowed           Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  clientCarCardAssignments ClientCarCardAssignment[]

  @@index([clientId])
}

model ClientCarCardAssignment {
  id           String     @id @default(uuid())
  clientCarId  String
  clientCar    ClientCar  @relation(fields: [clientCarId], references: [id])
  cardCopyId   BigInt
  cardCopy     CardCopy   @relation(fields: [cardCopyId], references: [id])
  assignedAt   DateTime   @default(now())
  unassignedAt DateTime?
  status       StatusType @default(active)

  @@index([clientCarId])
  @@index([cardCopyId])
}

model GeneralTransaction {
  id                         String                      @id @default(uuid())
  transactionCode            String                      @unique
  itemId                     String
  item                       Item                        @relation(fields: [itemId], references: [id])
  cuveId                     String
  cuve                       TblCuve                     @relation(fields: [cuveId], references: [id])
  pumpId                     String
  pump                       TblPump                     @relation(fields: [pumpId], references: [id])
  nozzleId                   String
  nozzle                     TblNozzle                   @relation(fields: [nozzleId], references: [id])
  clientId                   String?
  client                     Client?                     @relation(fields: [clientId], references: [id])
  cardCopyId                 BigInt?
  cardCopy                   CardCopy?                   @relation(fields: [cardCopyId], references: [id])
  platNumber                 String?
  platePictureUrl            String?
  quantity                   Decimal                     @default(0.0) @db.Decimal(18, 2)
  unitPrice                  Decimal                     @default(0.0) @db.Decimal(18, 2)
  amount                     Decimal                     @default(0.0) @db.Decimal(18, 2)
  siteId                     String
  site                       TblSite                     @relation(fields: [siteId], references: [id])
  /// What the discount came to. **Recorded, not deducted**: `amount` is the
  /// full gross, and this is written down beside it for later.
  discountAmount             Decimal                     @default(0.0) @db.Decimal(18, 2)
  /// The percentage off, as the discount stood when the sale was priced.
  discountRate               Decimal                     @default(0.00) @db.Decimal(18, 2)
  /// The discount that priced it, kept only to trace it back.
  discountId                 String?
  discount                   Discount?                   @relation(fields: [discountId], references: [id], onDelete: SetNull)
  shiftId                    String?
  shift                      TblShiftSite?               @relation(fields: [shiftId], references: [id])
  displayPictureUrl          String?
  doneBy                     String?
  user                       User?                       @relation(fields: [doneBy], references: [id])
  reason                     String?
  comments                   String?
  printStatus                Boolean                     @default(false)
  appVersion                 String?
  /// Towards each unit sold, as the subsidy stood when the sale was priced —
  /// a fixed amount a litre, never a percentage.
  subsidyRate                Decimal                     @default(0.0) @db.Decimal(12, 2)
  /// `quantity × subsidyRate`. Recorded, never taken off what was collected.
  subsidyAmount              Decimal                     @default(0.0) @db.Decimal(18, 2)
  /// The subsidy the sale earned, kept only to trace it back.
  subsidyId                  String?
  subsidy                    Subsidy?                    @relation(fields: [subsidyId], references: [id], onDelete: SetNull)
  /// initiated by the POS, then confirmed once (or cancelled).
  status                     GeneralTransactionStatus    @default(initiated)
  /// When an initiated sale is cancelled if not confirmed by then; empty = never
  /// (a sale paid with coupons waits as long as it takes).
  expiresAt                  DateTime?
  confirmedAt                DateTime?
  /// The POS that recorded it.
  deviceId                   String?
  device                     SiteDevice?                 @relation(fields: [deviceId], references: [id])
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  generalTransactionPayments GeneralTransactionPayment[]
  /// The tank ledger row written when the sale is confirmed.
  cuveTransaction            CuveTransaction?
  couponRedemptions          CouponRedemption[]

  @@index([siteId, createdAt])
  @@index([siteId, id])
  @@index([status])
  @@index([discountId])
  @@index([subsidyId])
}

/// What the state pays towards a litre of a product, for a period.
///
/// A product has **at most one active subsidy at a time**: creating or
/// activating one retires whatever was active on that product. MySQL has no
/// partial unique index, so the invariant lives in the write transaction —
/// see `subsidy.repository.ts`.
model Subsidy {
  id        String     @id @default(uuid())
  itemId    String
  item      Item       @relation(fields: [itemId], references: [id])
  /// Empty when the subsidy applies at every site.
  siteId    String?
  site      TblSite?   @relation(fields: [siteId], references: [id])
  /// Paid towards each unit sold, in the unit the product is priced in.
  rate      Decimal    @db.Decimal(12, 2)
  from      DateTime   @db.Date
  to        DateTime   @db.Date
  status    StatusType @default(active)
  note      String?
  createdBy String
  user      User       @relation(fields: [createdBy], references: [id])
  createdAt DateTime   @default(now())
  updated   DateTime   @updatedAt

  /// The sales that earned it; each keeps its own copy of the figures.
  fuelSales           FuelSale[]
  generalTransactions GeneralTransaction[]

  @@index([itemId, status])
  @@index([siteId])
  @@index([createdBy])
}

enum GeneralTransactionStatus {
  initiated
  confirmed
  cancelled
}

model GeneralTransactionPayment {
  id              String             @id @default(cuid())
  transactionId   String
  transaction     GeneralTransaction @relation(fields: [transactionId], references: [id])
  accountId       String
  account         CompanyAccount     @relation(fields: [accountId], references: [id])
  amount          Decimal            @db.Decimal(18, 2)
  /// The mobile-money / bank / card reference. Required when the account's
  /// `requiredReference` is on.
  reference       String?
  referenceDocUrl String?
  createdAt       DateTime           @default(now())

  @@unique([transactionId, accountId])
  @@index([transactionId])
  @@index([accountId])
}

enum BackupStatus {
  queued
  running
  completed
  failed
  /// The file was deleted: its retention ran out, or someone removed it.
  expired
}

enum BackupTrigger {
  manual
  scheduled
}

/// A database backup: the job and, once done, the encrypted file it produced.
/// The row stays after the file is gone, as a record of who made and fetched it.
model Backup {
  id               String        @id @default(uuid())
  status           BackupStatus  @default(queued)
  trigger          BackupTrigger @default(manual)
  /// The file's name inside BACKUP_DIR; never a path or a URL.
  fileName         String?
  sizeBytes        BigInt?
  /// SHA-256 of the encrypted file, to check a download arrived whole.
  sha256           String?       @db.Char(64)
  /// Which encryption key sealed it (BACKUP_KEY_ID at the time).
  keyId            String?
  error            String?       @db.Text
  /// Who asked for it; empty for a nightly backup.
  createdBy        String?
  creator          User?         @relation("BackupCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  /// When the file is deleted.
  expiresAt        DateTime?
  downloadCount    Int           @default(0)
  lastDownloadedAt DateTime?
  lastDownloadedBy String?
  lastDownloader   User?         @relation("BackupDownloader", fields: [lastDownloadedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdBy])
  @@index([lastDownloadedBy])
}

/// Somewhere a vehicle can stand: a yard, a depot gate, an offloading bay.
model Parking {
  id               String            @id @default(uuid())
  name             String
  location         String
  status           StatusType        @default(active)
  createdAt        DateTime          @default(now())
  vehicleLocations VehicleLocation[]

  @@unique([name, location])
  @@index([status])
}

/// Where one vehicle is standing, on one trip.
///
/// A vehicle in transit may be parked and still be in transit — it moves from
/// parking to parking until it is offloaded — so this is a log of where it has
/// been, not a stage of its own. Exactly one row per vehicle is `active`,
/// which the assignment enforces: MySQL has no partial unique index, so the
/// previous one is deactivated in the same transaction.
model VehicleLocation {
  id              String         @id @default(uuid())
  parkingId       String
  parking         Parking        @relation(fields: [parkingId], references: [id])
  driverVehicleId String
  driverVehicle   DriverVehicles @relation(fields: [driverVehicleId], references: [id])
  /// The trip that parked here, so receiving its stock can release it.
  nominationId    String
  nomination      Nomination     @relation(fields: [nominationId], references: [id])
  status          StatusType     @default(active)
  /// Null until the vehicle actually reaches the parking it was sent to.
  arrivedAt       DateTime?
  /// When it left — the question a parking history is asked.
  releasedAt      DateTime?
  assignedBy      String
  user            User           @relation(fields: [assignedBy], references: [id])
  createdAt       DateTime       @default(now())

  @@index([driverVehicleId, status])
  @@index([nominationId, status])
  @@index([parkingId, status])
  @@index([createdAt])
}

/// A fee that can be charged against stock or a proforma: its name and what it
/// currently costs. The amount here is only the default a form prefills — every
/// charge keeps its own copy, so editing this price never re-values what was
/// charged in the past.
model FeeType {
  id             String          @id @default(uuid())
  name           String
  amount         Decimal         @db.Decimal(18, 2)
  /// Fees are not always in the same money as the invoice they sit beside, so
  /// totals are grouped by this rather than added blindly.
  currencyCode   String          @default("RWF")
  status         StatusType      @default(active)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  chainStockFees ChainStockFee[]
  pfiFees        PfiFee[]

  @@unique([name])
  @@index([status])
}

/// A fee charged against one stock receipt.
///
/// `name`, `unitAmount` and `currencyCode` are copies taken when the fee was
/// charged: a landed cost worked out last quarter must not move because a price
/// was edited today.
/// What it cost to land one receipt of central stock: clearing, storage,
/// transport and the rest, charged from the fee catalogue.
///
/// It hangs off `CentralStock`, not `Stock`: the cost is known when the stock
/// is received into the depot, which is when a central stock receipt is
/// written. Each row keeps its own `name`, `unitAmount` and `currencyCode`,
/// copied from `FeeType` when it is charged, so editing the catalogue later
/// cannot rewrite what a receipt cost.
model ChainStockFee {
  id             String       @id @default(uuid())
  feeTypeId      String
  centralStockId String
  count          Int          @default(1)
  name           String
  unitAmount     Decimal      @db.Decimal(18, 2)
  currencyCode   String
  feeType        FeeType      @relation(fields: [feeTypeId], references: [id])
  centralStock   CentralStock @relation(fields: [centralStockId], references: [id])
  createdBy      String?
  user           User?        @relation("ChainStockFeeCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([centralStockId, feeTypeId])
  @@index([centralStockId])
  @@index([feeTypeId])
  @@index([createdBy])
}

/// A fee charged against one proforma invoice, with its figures copied for the
/// same reason as `ChainStockFee`.
model PfiFee {
  id           String   @id @default(uuid())
  feeTypeId    String
  pfiId        String
  count        Int      @default(1)
  name         String
  unitAmount   Decimal  @db.Decimal(18, 2)
  currencyCode String
  feeType      FeeType  @relation(fields: [feeTypeId], references: [id])
  pfi          Pfi      @relation(fields: [pfiId], references: [id])
  createdBy    String?
  user         User?    @relation("PfiFeeCreatedBy", fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())

  @@unique([pfiId, feeTypeId])
  @@index([pfiId])
  @@index([feeTypeId])
  @@index([createdBy])
}

/// One nozzle's meter readings for one shift of one working day: what the
/// counter stood at when the shift opened and when it closed, and the price a
/// litre was selling at.
///
/// The readings of a nozzle are a **chain**: `startIndex` is the previous
/// reading's `endIndex`, so only the closing figure is ever typed. The first
/// reading on a nozzle is the exception — it carries the counter as it stood
/// when the station started recording.
///
/// Approved (`confirmedBy`) is final: a reading is never deleted and never
/// edited after that, so the chain behind it cannot be rewritten.
model PumpIndex {
  id            String       @id @default(uuid())
  pumpId        String
  pump          TblPump      @relation(fields: [pumpId], references: [id])
  nozzleId      String
  nozzle        TblNozzle    @relation(fields: [nozzleId], references: [id])
  /// The product the nozzle's tank holds, copied when the reading is recorded.
  itemId        String
  item          Item         @relation(fields: [itemId], references: [id])
  /// What a litre was selling at, copied from the price in force: a later
  /// price change must not rewrite what this shift sold at.
  sellingPrice  Decimal      @default(0.0) @db.Decimal(18, 2)
  shiftSiteId   String
  shiftSite     TblShiftSite @relation(fields: [shiftSiteId], references: [id])
  siteId        String
  site          TblSite      @relation(fields: [siteId], references: [id])
  /// The working day the shift belongs to, as the fuel sales and the time
  /// table count it: a night shift's small hours still count towards the day
  /// it started on.
  dateOn        DateTime     @db.Date
  /// Whose shift on this nozzle the reading is for. The time table must put
  /// them on the shift that day, and the rota on that pump and nozzle — the
  /// same three facts the POS checks before it lets them confirm a sale, so
  /// the meter and the sales can be read against each other.
  attendantId   String
  attendant     User         @relation(name: "pumpIndexAttendant", fields: [attendantId], references: [id])
  /// Carried from the previous reading on this nozzle; typed only for the first.
  startIndex    Decimal      @default(0.0) @db.Decimal(18, 2)
  /// What the counter stood at when the shift closed. The litres through the
  /// nozzle are `endIndex - startIndex`.
  endIndex      Decimal      @default(0.0) @db.Decimal(18, 2)
  createdBy     String
  user          User         @relation(name: "pumpIndexCreatedBy", fields: [createdBy], references: [id])
  /// Who approved it. Set once, and the reading is frozen from then on.
  confirmedBy   String?
  confirmedUser User?        @relation(name: "pumpIndexConfirmed", fields: [confirmedBy], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime     @default(now())

  /// One reading per nozzle per shift per working day.
  @@unique([nozzleId, shiftSiteId, dateOn])
  @@index([siteId, dateOn])
  @@index([nozzleId, dateOn])
  @@index([pumpId])
  @@index([itemId])
  @@index([shiftSiteId])
  @@index([attendantId])
  @@index([createdBy])
  @@index([confirmedBy])
}



