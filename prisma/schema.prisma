generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  isFixed     Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model CompanySettings {
  id          String   @id @default(uuid())
  companyName String   @default("")
  address     String?
  phone       String?
  email       String?
  taxId       String?
  currency    String   @default("USD")
  logoPath    String?
  updatedAt   DateTime @updatedAt
}

model Module {
  id          String       @id @default(uuid())
  name        String
  icon        String?
  code        String       @unique
  parentId    String?
  parent      Module?      @relation("ModuleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Module[]     @relation("ModuleHierarchy")
  sorting     Int          @default(0)
  createdAt   DateTime     @default(now())
  permissions Permission[]

  @@index([parentId])
}

model Permission {
  id              String           @id @default(uuid())
  moduleId        String
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@index([moduleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("RolePermissions")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  pinHash             String?
  firstName           String
  lastName            String
  phone               String?
  roleId              String?
  role                Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
  lineLines           NominationTimeLine[]

  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
}

// phase 2 of impementing items

model Item {
  id           String     @id @default(uuid())
  name         String
  descriptions String?
  parentId     String?
  baseUnitId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       StatusType @default(active)

  baseUnit  Unit?      @relation(fields: [baseUnitId], references: [id], onDelete: SetNull)
  itemUnits ItemUnit[]

  itemClass     Item?          @relation("ItemHierarchy", fields: [parentId], references: [id])
  items         Item[]         @relation("ItemHierarchy")
  orders        Order[]
  stock         Stock[]
  centralStocks CentralStock[]

  @@index([id])
  @@index([parentId])
}

model Unit {
  id         String     @id @default(uuid())
  name       String
  code       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  status     StatusType @default(active)
  itemsUnits ItemUnit[]
  items      Item[]

  @@index([id])
}

model ItemUnit {
  id             String     @id @default(uuid())
  unitId         String
  itemId         String
  factorialValue Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  status         StatusType @default(active)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, itemId])
  @@index([id])
  @@index([unitId])
  @@index([itemId])
}

model Supplier {
  id             String       @id @default(uuid())
  name           String
  address        String?
  phone          String?
  tinNumber      String?
  supplierTypeId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  status         StatusType   @default(active)
  supplierType   SupplierType @relation(fields: [supplierTypeId], references: [id])
  orders         Order[]

  @@index([id])
  @@index([supplierTypeId])
}

model SupplierType {
  id        String     @id @default(uuid())
  type      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  status    StatusType @default(active)
  suppliers Supplier[]

  @@index([id])
}

enum StatusType {
  active
  inactive
}

// for orders and order plans

model OrderPlan {
  id        String     @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    PlanStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]

  @@index([id])
  @@index([startDate, endDate])
  @@index([status])
}

enum PlanStatus {
  active
  closed
  terminated
  force_closed
}

model Order {
  id              String    @id @default(uuid())
  orderCode       String    @unique
  supplierId      String
  orderDate       DateTime
  itemId          String
  createdByUserId String
  orderPlanId     String
  quantity        Decimal   @db.Decimal(18, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  plan            OrderPlan @relation(fields: [orderPlanId], references: [id])
  item            Item      @relation(fields: [itemId], references: [id])
  createdUser     User      @relation(fields: [createdByUserId], references: [id])
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  cargos          Cargo[]

  @@index([id])
  @@index([orderCode])
  @@index([supplierId])
  @@index([createdByUserId])
  @@index([orderPlanId])
  @@map("orders")
}

// moving to Deports

model Deport {
  id            String         @id @default(uuid())
  name          String
  type          DeportType     @default(local)
  location      String
  status        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  stocks        Stock[]
  cargos        Cargo[]
  centralStocks CentralStock[]

  @@index([id])
  @@index([status])
}

enum DeportType {
  local
  foreign
  international
}

model Transporter {
  id        String     @id @default(uuid())
  name      String
  phone     String
  address   String
  tinNumber String
  status    StatusType @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vehicles  Vehicle[]
  drivers   Driver[]

  @@index([id])
}

model Vehicle {
  id            String           @id @default(uuid())
  platNumber    String
  transporterId String
  transport     Transporter      @relation(fields: [transporterId], references: [id])
  truckNumber   String
  trailerNumber String
  model         String
  tankCapacity  Decimal          @db.Decimal(18, 2)
  status        StatusType       @default(active)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  drivers       DriverVehicles[]

  @@index([id])
  @@index([transporterId])
}

model Driver {
  id            String           @id @default(uuid())
  names         String
  phone         String
  lisence       String
  passport      String
  transporterId String
  transport     Transporter      @relation(fields: [transporterId], references: [id])
  status        StatusType       @default(active)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  vehicles      DriverVehicles[]

  @@index([id])
  @@index([transporterId])
}

model DriverVehicles {
  id          String       @id @default(uuid())
  driverId    String
  driver      Driver       @relation(fields: [driverId], references: [id])
  vehicleId   String
  vechile     Vehicle      @relation(fields: [vehicleId], references: [id])
  status      StatusType   @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  nominations Nomination[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([driverId, vehicleId])
}

// moving to cargo

model Cargo {
  id               String      @id @default(cuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id])
  deportId         String
  deport           Deport      @relation(fields: [deportId], references: [id])
  vesselName       String
  receivedDate     DateTime
  expirationDate   DateTime
  quantity         Decimal     @default(0.0) @db.Decimal(18, 2)
  blRef            String
  supportingDocUrl String?
  tansisRef        String?
  outurnRef        String?
  status           CargoStatus @default(pending)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  stocks           Stock[]

  @@index([orderId])
  @@index([blRef])
  @@index([tansisRef])
  @@index([receivedDate])
  @@index([status])
}

model Stock {
  id           String       @id @default(uuid())
  deportId     String
  deport       Deport       @relation(fields: [deportId], references: [id])
  cargoId      String
  cargo        Cargo        @relation(fields: [cargoId], references: [id])
  itemId       String
  item         Item  @relation(fields: [itemId], references: [id])
  quantity     Decimal      @db.Decimal(18, 2)
  receivedDate DateTime
  status       StockStatus  @default(awaiting)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  nominations  Nomination[]

  @@index([deportId])
  @@index([cargoId])
  @@index([status])
}

enum StockStatus {
  awaiting
  cancelled
  returned
  received
}

enum CargoStatus {
  pending
  approved
  cancelled
}

model Nomination {
  id                  String               @id @default(uuid())
  stockId             String
  stock               Stock                @relation(fields: [stockId], references: [id])
  driverVehicleId     String
  driverVehicle       DriverVehicles       @relation(fields: [driverVehicleId], references: [id])
  quantity            Decimal              @db.Decimal(18, 2)
  destination         String
  expectedLoadingDate DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  pfis                Pfi[]
  timeLine            NominationTimeLine[]
  t1Validations       T1Validation[]

  @@index([stockId])
  @@index([driverVehicleId])
}

model Currency {
  id        String   @id @default(uuid())
  code      String
  name      String
  rate      Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pifs      Pfi[]
}

model Pfi {
  id           String     @id @default(uuid())
  currencyId   String
  currency     Currency   @relation(fields: [currencyId], references: [id])
  nominationId String
  nomination   Nomination @relation(fields: [nominationId], references: [id])
  currancyCode String
  rate         Decimal    @db.Decimal(12, 2)
  amount       Decimal    @db.Decimal(18, 2)
  pifCode      String     @unique
  pfiReference String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([nominationId])
  @@index([id])
}

model NominationTimeLine {
  id           String     @id @default(uuid())
  nominationId String
  nomination   Nomination @relation(fields: [nominationId], references: [id])
  status       String
  changedBy    String?
  user         User?      @relation(fields: [changedBy], references: [id])
  descriptions String?
  createdAt    DateTime   @default(now())

  @@index([nominationId])
}

model T1Validation {
  id               String     @id @default(uuid())
  nominationId     String
  nomination       Nomination @relation(fields: [nominationId], references: [id])
  exportingCountry String
  supportingDocUrl String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  extraValidations ExtraT1Validation[]

  centralStocks CentralStock[]

  @@index([nominationId])
  @@index([id])
}

model ExtraT1Validation {
  id               String                  @id @default(uuid())
  t1ValidationId   String
  validation       T1Validation            @relation(fields: [t1ValidationId], references: [id])
  customOffice     String
  transitNumbering String
  status           ExtraT1ValidationStatus @default(pending)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([t1ValidationId])
}

enum ExtraT1ValidationStatus {
  pending
  cancelled
  confirmed
}

model CentralStock {
  id               String             @id @default(uuid())
  deportId         String
  deport           Deport             @relation(fields: [deportId], references: [id])
  itemId           String
  item             Item               @relation(fields: [itemId], references: [id])
  quantity         Decimal            @db.Decimal(18, 2)
  supportingDocUrl String?
  t1ValidationId   String
  t1Validation     T1Validation       @relation(fields: [t1ValidationId], references: [id])
  status           CentralStockStatus @default(inStock)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  transactions     StockTransaction[]

  @@index([id])
  @@index([deportId])
  @@index([itemId])
  @@index([t1ValidationId])
  @@index([status])
}

enum CentralStockStatus {
  inStock
  stockOut
}

model StockTransaction {
  id             String               @id @default(uuid())
  centralStockId String
  centralStock   CentralStock         @relation(fields: [centralStockId], references: [id])
  quantity       Decimal              @db.Decimal(18, 2)
  type           StockTransactionType
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([id])
  @@index([centralStockId])
}

enum StockTransactionType {
  saleOut
  reconcilliation
  received
}
