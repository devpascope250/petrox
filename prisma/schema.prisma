  clientWalletId   String
  wallet           ClientWallet                   @relation(fields: [clientWalletId], references: [id])
  accountId        String?
  account          CompanyAccount?                @relation(fields: [accountId], references: [id])
  referenceId      String?
  type             WalletTransactionType
  direction        WalletTransactionDirectionType
  supportingDocUrl String?
  amount           Decimal                        @db.Decimal(18, 2)
  createdAt        DateTime                       @default(now())

  @@index([clientWalletId])
  @@index([accountId])
  @@index([referenceId])
}

enum WalletTransactionDirectionType {
  IN
  OUT
}

enum WalletTransactionType {
  DEPOSIT
  PAYMENT
  REFUND
  LOAN
  WITHDRAWAL
  TRANSFER
  ADJUSTMENT
}

model Card {
  id               BigInt    @id @default(autoincrement())
  cardNumber       String?   @unique
  serialNumber     String?   @unique
  cardCode         String?
  balance          Decimal   @default(0.0) @db.Decimal(18, 2)
  availability     Boolean   @default(true)
  /// What kind of card it is, and so which rules (CardSetting) apply to it.
  cardTypeId       String?
  cardType         CardType? @relation(fields: [cardTypeId], references: [id])
  // COMMENT '1=Ordinary 2=Specific',
  securityCategory Int?
  state            Int       @default(0)
  swapStatus       Int?
  inventoryStatus  Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  originalCards CardCopy[] @relation("originalCards")
  copyCards     CardCopy[] @relation("copyCardFromCard")

  @@index([cardNumber])
  @@index([cardTypeId])
}

/// A kind of card (prepaid, postpaid, fleet…). Never deleted: switched off instead.
model CardType {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  status      StatusType   @default(active)
  createdBy   String
  user        User         @relation(fields: [createdBy], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cards       Card[]
  setting     CardSetting?
}

/// The rules every card of a type follows when it is used.
model CardSetting {
  id                  String           @id @default(uuid())
  cardTypeId          String           @unique
  cardType            CardType         @relation(fields: [cardTypeId], references: [id], onDelete: Cascade)
  /// The holder must enter the card's PIN.
  requirePin          Boolean          @default(true)
  /// The vehicle's plate number must be typed in.
  requirePlateNumber  Boolean          @default(false)
  /// A picture of the vehicle's plate number must be taken.
  capturePlatePicture Boolean          @default(false)
  /// The vehicle's odometer (mileage) reading must be recorded.
  requireOdometer     Boolean          @default(false)
  /// The card may be used past its balance, to be settled later (postpaid).
  allowCredit         Boolean          @default(false)
  /// Spending is capped at `limitAmount` per `limitPeriod`.
  hasLimit            Boolean          @default(false)
  showBalance         Boolean          @default(true)
  captureDisplay      Boolean          @default(false)
  limitAmount         Decimal?         @db.Decimal(18, 2)
  limitPeriod         CardLimitPeriod?
  updatedAt           DateTime         @updatedAt
}

enum CardLimitPeriod {
  transaction
  daily
  weekly
  monthly
}

model CardCopy {
