  amount      Decimal                          @default(0.0) @db.Decimal(18, 2)
  createdById String
  user        User                             @relation(fields: [createdById], references: [id])
  createdAt   DateTime                         @default(now())

  @@index([carfdCopyId])
  @@index([carfdCopyId, type])
  @@index([carfdCopyId, direction])
}

enum CardCopyTransactionDirectionType {
  IN
  OUT
}

enum CardTransactionType {
  DEPOSIT
  PAYMENT
  REFUND
  LOAN
  WITHDRAWAL
  TRANSFER
  ADJUSTMENT
}

model Discount {
