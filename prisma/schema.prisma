  site              TblSite?           @relation(fields: [siteId], references: [id])
  requiredReference Boolean            @default(false)
  status            StatusType         @default(active)
  createdAtBy       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user                       User                        @relation(fields: [createdAtBy], references: [id])
  walletTransactions         walletTransaction[]
  fuelSalePayments           FuelSalePayment[]
  generalTransactionPayments GeneralTransactionPayment[]
}

enum CompanyAccountType {
  cash
  bank
  mobileMoney
  transfer
  card
  coupon
}

model ClientWallet {
  id                 String              @id @default(cuid())
  amount             Decimal             @default(0.0) @db.Decimal(18, 2)
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id])
  createdAtBy        String
  status             StatusType          @default(active)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
