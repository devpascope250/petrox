generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  isFixed     Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
  authorizers Authorizers[]
}

/// The company's own details, printed on POS receipts. One row only.
model CompanySettings {
  id            String   @id @default(uuid())
  companyName   String   @default("")
  address       String?
  phone         String?
  email         String?
  /// TIN, printed on receipts.
  taxId         String?
  website       String?
  currency      String   @default("USD")
  logoPath      String?
  /// A line at the bottom of every receipt, e.g. "Thank you for your business".
  receiptFooter String?  @db.VarChar(255)
  updatedAt     DateTime @updatedAt
}

model Module {
  id          String       @id @default(uuid())
  name        String
  icon        String?
  code        String       @unique
  parentId    String?
  parent      Module?      @relation("ModuleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Module[]     @relation("ModuleHierarchy")
  sorting     Int          @default(0)
  createdAt   DateTime     @default(now())
  permissions Permission[]

  @@index([parentId])
}

model Permission {
  id              String           @id @default(uuid())
  moduleId        String
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@index([moduleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("RolePermissions")
}

model User {
  id                         String                   @id @default(uuid())
  email                      String                   @unique
  passwordHash               String
  pinHash                    String?
  firstName                  String
  lastName                   String
  phone                      String?                  @unique
  roleId                     String?
  role                       Role?                    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive                   Boolean                  @default(true)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  clientId                   String?
  siteId                     String?
  /// Their signature image, stamped onto a document they authorise. Optional:
  /// most users never sign anything. An authoriser without one cannot approve.
  signatureUrl               String?
  /// The site they work at now. `UserSites` keeps every site they were assigned, with this one active.
  site                       TblSite?                 @relation("UserHomeSite", fields: [siteId], references: [id], onDelete: SetNull)
  position                   UserPositions            @default(siteManager)
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  orders                     Order[]
  lineLines                  NominationTimeLine[]
  stockTransactions          StockTransaction[]
  createdCentralStockOrders  CentralStockOrder[]      @relation("CentralStockOrderCreatedByUser")
  approvedCentralStockOrders CentralStockOrder[]      @relation("CentralStockOrderApprovedByUser")
  stockClearances            StockClearance[]
  client                     Client?                  @relation(fields: [clientId], references: [id])
  sites                      UserSites[]
  loadingOrderAuthorizers    LoadingOrderAuthorizer[]
  companyAccounts            CompanyAccount[]
  clientWallets              ClientWallet[]
  orderReceptions            OrderReception[]
  discounts                  Discount[]
  cardCopyTransactions       CardCopyTransaction[]
  timeTablesUser             TblTimeTable[]           @relation("TimeTableUsers")
  tblPumpAttendants          TblPumpAttendant[]
  cuveTransactions           CuveTransaction[]
  loadingOrderShares         LoadingOrderShare[]      @relation("LoadingOrderSharedBy")
  centralStockOrderEvents    CentralStockOrderEvent[] @relation("CentralStockOrderEventActor")
  chainStockFees             ChainStockFee[]          @relation("ChainStockFeeCreatedBy")
  pfiFees                    PfiFee[]                 @relation("PfiFeeCreatedBy")
  fuelSales                  FuelSale[]
  cardTypes                  CardType[]
  provisioningKeys           SiteProvisioningKey[]    @relation("ProvisioningKeyCreator")
  revokedDevices             SiteDevice[]             @relation("DeviceRevoker")
  itemPrices                 ItemPrice[]
  generalTransactions        GeneralTransaction[]

  backupsRequested       Backup[]           @relation("BackupCreator")
  backupsDownloaded      Backup[]           @relation("BackupDownloader")
  couponRedemptions      CouponRedemption[] @relation("CouponRedeemer")
  vehicleLocations       VehicleLocation[]
  subsidies              Subsidy[]
  createdBypumpIndexes   PumpIndex[]        @relation("pumpIndexCreatedBy")
  confirmedByPumpIndexes PumpIndex[]        @relation("pumpIndexConfirmed")
  attendedPumpIndexes    PumpIndex[]        @relation("pumpIndexAttendant")

  @@index([roleId])
  @@index([siteId])
}

enum UserPositions {
  superAdmin
  siteManager
  clientAdmin
  clientUser
  /// Staff who work at a site but manage nothing there, e.g. a pompiste.
  others
}

model Client {
  id                  String               @id @default(uuid())
  clientCode          String               @unique
  name                String?
  phone               String?
  email               String?
  idTino              String?
  province            String?
  proviceLocation     Location?            @relation("ProviceLocationsRef", fields: [province], references: [id], onDelete: SetNull)
  district            String?
  districtLocation    Location?            @relation("DistrictLocationRef", fields: [district], references: [id], onDelete: SetNull)
  sector              String?
  sectorLocation      Location?            @relation("SectorLocationRef", fields: [sector], references: [id], onDelete: SetNull)
  status              Boolean              @default(true)
  /// Whether this client may earn a subsidy at all. The car at the pump must
  /// be allowed one too, so both flags have to be on.
  subsidyAllowed      Boolean              @default(false)
  /// The client's PIN, hashed: they enter it at the pump to pay with their coupons.
  pinHash             String?
  users               User[]
  clientWallets       ClientWallet[]
  cardCopies          CardCopy[]
  discounts           Discount[]
  clientCoupons       ClientCoupon[]
  clientCars          ClientCar[]
  generalTransactions GeneralTransaction[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
}

// phase 2 of impementing items

model Item {
  id           String     @id @default(uuid())
  name         String
  descriptions String?
  parentId     String?
  baseUnitId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       StatusType @default(active)

  baseUnit  Unit?      @relation(fields: [baseUnitId], references: [id], onDelete: SetNull)
  itemUnits ItemUnit[]

  itemClass           Item?                @relation("ItemHierarchy", fields: [parentId], references: [id])
  items               Item[]               @relation("ItemHierarchy")
  orders              Order[]
  stock               Stock[]
  centralStocks       CentralStock[]
  cuves               TblCuve[]
  toleranceRates      ItemToleranceRate[]
  clientCars          ClientCar[]
  generalTransactions GeneralTransaction[]
  subsidies           Subsidy[]
  pumpIndexes         PumpIndex[]

  @@index([id])
  @@index([parentId])
}

model Unit {
  id         String     @id @default(uuid())
  name       String
  code       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  status     StatusType @default(active)
  itemsUnits ItemUnit[]
  items      Item[]

  @@index([id])
}

model ItemUnit {
  id             String     @id @default(uuid())
  unitId         String
  itemId         String
  factorialValue Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  status         StatusType @default(active)

  item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  itemPrices ItemPrice[]

  @@unique([unitId, itemId])
  @@index([id])
  @@index([unitId])
  @@index([itemId])
}

model ItemPrice {
  id         String     @id @default(uuid())
  itemUnitId String
  itemUnit   ItemUnit   @relation(fields: [itemUnitId], references: [id])
  price      Decimal    @db.Decimal(18, 2)
  createdBy  String
  user       User       @relation(fields: [createdBy], references: [id])
  status     StatusType @default(active)
  createdAt  DateTime   @default(now())
}

model Supplier {
  id             String       @id @default(uuid())
  name           String
  address        String?
  phone          String?
  tinNumber      String?
  supplierTypeId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  status         StatusType   @default(active)
  supplierType   SupplierType @relation(fields: [supplierTypeId], references: [id])
  orders         Order[]

  @@index([id])
  @@index([supplierTypeId])
}

model SupplierType {
  id        String     @id @default(uuid())
  type      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  status    StatusType @default(active)
  suppliers Supplier[]

  @@index([id])
}

enum StatusType {
  active
  inactive
}

// for orders and order plans

model OrderPlan {
  id        String     @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    PlanStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]

  @@index([id])
  @@index([startDate, endDate])
  @@index([status])
}

enum PlanStatus {
  active
  closed
  terminated
  force_closed
}

model Order {
  id              String    @id @default(uuid())
  orderCode       String    @unique
  supplierId      String
  orderDate       DateTime
  itemId          String
  createdByUserId String
  orderPlanId     String
  quantity        Decimal   @db.Decimal(18, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  plan            OrderPlan @relation(fields: [orderPlanId], references: [id])
  item            Item      @relation(fields: [itemId], references: [id])
  createdUser     User      @relation(fields: [createdByUserId], references: [id])
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  cargos          Cargo[]

  @@index([id])
  @@index([orderCode])
  @@index([supplierId])
  @@index([createdByUserId])
  @@index([orderPlanId])
  @@map("orders")
}

// moving to Deports

model Deport {
  id            String         @id @default(uuid())
  name          String
  type          DeportType     @default(local)
  location      String
  status        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  stocks        Stock[]
  cargos        Cargo[]
  centralStocks CentralStock[]

  @@index([id])
  @@index([status])
}

enum DeportType {
  local
  foreign
  international
}

model Transporter {
  id        String     @id @default(uuid())
  name      String
  phone     String
  address   String
  tinNumber String
  status    StatusType @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vehicles  Vehicle[]
  drivers   Driver[]

  @@index([id])
}

model Vehicle {
  id            String           @id @default(uuid())
  platNumber    String
  transporterId String
  transport     Transporter      @relation(fields: [transporterId], references: [id])
  truckNumber   String
  trailerNumber String
  model         String
  tankCapacity  Decimal          @db.Decimal(18, 2)
  status        StatusType       @default(active)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  drivers       DriverVehicles[]

  @@index([id])
  @@index([transporterId])
}

model Driver {
  id            String           @id @default(uuid())
  names         String
  phone         String
  lisence       String
  passport      String
  transporterId String
  transport     Transporter      @relation(fields: [transporterId], references: [id])
  status        StatusType       @default(active)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  vehicles      DriverVehicles[]

  @@index([id])
  @@index([transporterId])
}

model DriverVehicles {
  id               String              @id @default(uuid())
  driverId         String
  driver           Driver              @relation(fields: [driverId], references: [id])
  vehicleId        String
  vechile          Vehicle             @relation(fields: [vehicleId], references: [id])
  status           DriverVehicleStatus @default(active)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  nominations      Nomination[]
  loadingOrders    LoadingOrder[]
  vehicleLocations VehicleLocation[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([driverId, vehicleId])
}

// driverVehicle status

enum DriverVehicleStatus {
  active
  inactive
  occupied
}

model LoadingOrder {
  id                  String                          @id @default(uuid())
  driverVehicleId     String
  totalQuantity       Decimal                         @db.Decimal(18, 2)
  authoriserCount     Int                             @default(1)
  status              LoadingOrderStatus              @default(pending)
  authorizationStatus LoadingOrderAuthorizationStatus @default(pending)
  dVehicle            DriverVehicles                  @relation(fields: [driverVehicleId], references: [id])
  authorizers         LoadingOrderAuthorizer[]
  shares              LoadingOrderShare[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  orderReceptions     OrderReception[]
  loadedOrders        LoadedOrder[]

  @@index([driverVehicleId])
}

/// A loading order sent out by email, kept so it is known who received the
/// document and when — it leaves the company, so it is worth a trail.
model LoadingOrderShare {
  id             String       @id @default(uuid())
  loadingOrderId String
  loadingOrder   LoadingOrder @relation(fields: [loadingOrderId], references: [id])
  /// The addresses it went to, as given — one row per send, not per address.
  recipients     String       @db.Text
  /// What the sender wrote above the document, if anything.
  message        String?      @db.Text
  sharedBy       String
  user           User         @relation("LoadingOrderSharedBy", fields: [sharedBy], references: [id])
  /// Null while the mail is being sent; set once it was accepted.
  sentAt         DateTime?
  /// Why it did not go, when it did not.
  failedReason   String?
  createdAt      DateTime     @default(now())

  @@index([loadingOrderId])
  @@index([sharedBy])
}

model LoadedOrder {
  id             String            @id @default(uuid())
  orderId        String
  order          CentralStockOrder @relation(fields: [orderId], references: [id])
  loadingOrderId String
  loadingOrder   LoadingOrder      @relation(fields: [loadingOrderId], references: [id])
  quantity       Decimal           @db.Decimal(18, 2)
  createdAt      DateTime          @default(now())

  @@unique([loadingOrderId, orderId])
  @@index([orderId])
  @@index([loadingOrderId])
}

model OrderReception {
  id              String             @id @default(uuid())
  loadingOrderId  String
  loadingOrder    LoadingOrder       @relation(fields: [loadingOrderId], references: [id])
  cuveId          String
  cuve            TblCuve            @relation(fields: [cuveId], references: [id])
  expectedQty     Decimal            @db.Decimal(18, 2)
  receivedQty     Decimal            @db.Decimal(18, 2)
  receivedBy      String
  comment         String?
  status          LoadingOrderStatus @default(pending)
  user            User               @relation(fields: [receivedBy], references: [id])
  createdAt       DateTime           @default(now())
  /// The tank ledger row this delivery produced.
  cuveTransaction CuveTransaction?

  @@index([loadingOrderId])
  @@index([cuveId])
}

enum LoadingOrderStatus {
  pending
  received
  cancelled
}

enum LoadingOrderAuthorizationStatus {
  pending
  approved
}

model LoadingOrderAuthorizer {
  id             String       @id @default(uuid())
  loadingOrderId String
  loadingOrder   LoadingOrder @relation(fields: [loadingOrderId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], map: "fk_loading_order_authorizer_user")
  authorizerId   String
  authorizer     Authorizers  @relation(fields: [authorizerId], references: [id])
  /// The signature as it was when this approval was given, and the name it was
  /// given under. Copies on purpose: a document already signed must not change
  /// because someone later replaced their signature or married.
  signatureUrl   String?
  signedName     String?
  createdAt      DateTime     @default(now())

  @@unique([loadingOrderId, userId])
  @@unique([loadingOrderId, authorizerId])
  @@index([loadingOrderId])
  @@index([userId])
  @@index([authorizerId])
}

model Authorizers {
  id        String                   @id @default(uuid())
  type      AuthoriserType
  levels    Int                      @default(1)
  roleId    String
  status    StatusType               @default(active)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  role      Role                     @relation(fields: [roleId], references: [id])
  approvals LoadingOrderAuthorizer[]

  @@unique([type, roleId])
  @@index([roleId])
}

enum AuthoriserType {
  LOADING_ORDER
}

// moving to cargo

model Cargo {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  deportId         String
  deport           Deport         @relation(fields: [deportId], references: [id])
  vesselName       String
  receivedDate     DateTime
  expirationDate   DateTime
  quantityInKg     Decimal        @default(0.0) @db.Decimal(18, 2)
  quantityInLitre  Decimal        @default(0.0) @db.Decimal(18, 2)
  blRef            String
  supportingDocUrl String?
  tansisRef        String?
  outurnRef        String?
  status           CargoStatus    @default(pending)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  stocks           Stock[]
  cargoInvoices    CargoInvoice[]
  pfis             Pfi[]

  @@index([orderId])
  @@index([blRef])
  @@index([tansisRef])
  @@index([receivedDate])
  @@index([status])
}

model Stock {
  id                String             @id @default(uuid())
  deportId          String
  deport            Deport             @relation(fields: [deportId], references: [id])
  cargoId           String
  cargo             Cargo              @relation(fields: [cargoId], references: [id])
  itemId            String
  item              Item               @relation(fields: [itemId], references: [id])
  quantity          Decimal            @db.Decimal(18, 2)
  receivedDate      DateTime
  status            StockStatus        @default(awaiting)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  nominationVessels NominationVessel[]

  @@index([deportId])
  @@index([cargoId])
  @@index([status])
}

enum StockStatus {
  awaiting
  cancelled
  returned
  received
}

enum CargoStatus {
  pending
  approved
  cancelled
}

model Nomination {
  id                  String               @id @default(uuid())
  driverVehicleId     String
  driverVehicle       DriverVehicles       @relation(fields: [driverVehicleId], references: [id])
  ambQuantity         Decimal              @default(0.0) @db.Decimal(18, 2)
  destination         String
  expectedLoadingDate DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  timeLine            NominationTimeLine[]
  t1Validations       T1Validation[]
  nominationVessels   NominationVessel[]
  vehicleLocations    VehicleLocation[]

  @@index([driverVehicleId])
}

model NominationVessel {
  id           String     @id @default(uuid())
  nominationId String
  nomination   Nomination @relation(fields: [nominationId], references: [id])
  stockId      String
  stock        Stock      @relation(fields: [stockId], references: [id])
  ambQuantity  Decimal    @default(0.0) @db.Decimal(18, 2)
  createdAt    DateTime   @default(now())

  @@index([stockId])
  @@index([nominationId])
}

model Currency {
  id        String   @id @default(uuid())
  code      String
  name      String
  rate      Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pifs      Pfi[]
}

model Pfi {
  id               String   @id @default(uuid())
  currencyId       String
  currency         Currency @relation(fields: [currencyId], references: [id])
  cargoId          String
  cargo            Cargo    @relation(fields: [cargoId], references: [id])
  currancyCode     String
  unitPrice        Decimal  @db.Decimal(12, 2)
  amount           Decimal  @db.Decimal(18, 2)
  supportingDocUrl String?
  pifCode          String   @unique
  pfiReference     String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  fees             PfiFee[]

  @@index([cargoId])
  @@index([id])
}

model NominationTimeLine {
  id               String                   @id @default(uuid())
  nominationId     String
  nomination       Nomination               @relation(fields: [nominationId], references: [id])
  timeLineStatusId String
  timeLineStatus   NominationTimeLineStatus @relation(fields: [timeLineStatusId], references: [id])
  changedBy        String?
  user             User?                    @relation(fields: [changedBy], references: [id])
  descriptions     String?
  createdAt        DateTime                 @default(now())

  @@index([nominationId])
  @@index([timeLineStatusId])
}

model NominationTimeLineStatus {
  id           String               @id @default(uuid())
  status       TimeLineStatus       @unique
  level        Int
  descriptions String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  timeLines    NominationTimeLine[]

  @@index([status])
}

enum TimeLineStatus {
  awaiting
  underLoading
  t1Pending
  t1Confirmed
  stockReceived
  /// Level 5, between t1Confirmed and stockReceived. Appended here on purpose:
  /// MySQL stores an enum by index, and the ladder is ordered by `level`.
  inTransit
}

model T1Validation {
  id               String     @id @default(uuid())
  nominationId     String     @unique
  nomination       Nomination @relation(fields: [nominationId], references: [id])
  exportingCountry String
  quantityAt20C    Decimal    @default(0.0) @db.Decimal(18, 2)
  supportingDocUrl String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  extraValidations ExtraT1Validation[]

  centralStocks CentralStock[]

  @@index([nominationId])
  @@index([id])
}

model ExtraT1Validation {
  id             String                  @id @default(uuid())
  t1ValidationId String
  validation     T1Validation            @relation(fields: [t1ValidationId], references: [id])
  customOffice   String
  // transitNumbering String
  status         ExtraT1ValidationStatus @default(pending)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([t1ValidationId])
}

enum ExtraT1ValidationStatus {
  pending
  cancelled
  confirmed
}

model CentralStock {
  id                 String              @id @default(uuid())
  deportId           String
  deport             Deport              @relation(fields: [deportId], references: [id])
  itemId             String
  item               Item                @relation(fields: [itemId], references: [id])
  ambQuantity        Decimal             @default(0.0) @db.Decimal(18, 2)
  quantityAt20C      Decimal             @default(0.0) @db.Decimal(18, 2)
  receiptNumber      String?
  supportingDocUrl   String?
  t1ValidationId     String
  t1Validation       T1Validation        @relation(fields: [t1ValidationId], references: [id])
  status             CentralStockStatus  @default(inStock)
  toleranceRate      Decimal?            @db.Decimal(12, 2)
  lossQty            Decimal?            @db.Decimal(18, 2)
  gainQty            Decimal?            @db.Decimal(18, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  stockClearances    StockClearance[]
  transactions       StockTransaction[]
  centralStockOrders CentralStockOrder[]
  /// What it cost to land this receipt — charged as the stock is received.
  chainStockFees     ChainStockFee[]

  @@index([id])
  @@index([deportId])
  @@index([itemId])
  @@index([t1ValidationId])
  @@index([status])
}

enum CentralStockStatus {
  inStock
  stockOut
}

model StockTransaction {
  id               String               @id @default(uuid())
  centralStockId   String
  centralStock     CentralStock         @relation(fields: [centralStockId], references: [id])
  quantity         Decimal              @db.Decimal(18, 2)
  note             String?
  supportingDocUrl String?
  type             StockTransactionType
  createdBy        String
  user             User                 @relation(fields: [createdBy], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([id])
  @@index([centralStockId])
}

model StockClearance {
  id                 String              @id @default(uuid())
  centralStockId     String
  centralStock       CentralStock        @relation(fields: [centralStockId], references: [id])
  quantity           Decimal             @db.Decimal(18, 2)
  fees               Decimal?            @db.Decimal(18, 2)
  amount             Decimal?            @db.Decimal(18, 2)
  status             StockStateStatus    @default(uncleared)
  clearedBy          String?
  user               User?               @relation(fields: [clearedBy], references: [id])
  agentId            String?
  agent              ClearingAgent?      @relation(fields: [agentId], references: [id])
  supportingDocUrl   String?
  dmsDocUrl          String?
  assessmentDocUrl   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  centralStockOrders CentralStockOrder[]

  @@index([id])
  @@index([centralStockId])
}

model ClearingAgent {
  id              String           @id @default(uuid())
  names           String
  fees            Decimal          @db.Decimal(18, 2)
  status          StatusType       @default(active)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  stockClearances StockClearance[]
}

enum StockStateStatus {
  cleared
  uncleared
}

enum StockTransactionType {
  saleOut
  reconcilliationIn
  reconcilliationOut
  received
}

model CentralStockOrder {
  id             String                   @id @default(uuid())
  siteId         String?
  site           TblSite?                 @relation(fields: [siteId], references: [id])
  clearanceId    String
  clearance      StockClearance           @relation(fields: [clearanceId], references: [id])
  centralStockId String
  centralStock   CentralStock             @relation(fields: [centralStockId], references: [id])
  orderType      CentralStockOrderType
  quantity       Decimal                  @db.Decimal(18, 2)
  unitPrice      Decimal                  @db.Decimal(18, 2)
  totalPrice     Decimal                  @db.Decimal(18, 2)
  createdBy      String
  user           User                     @relation("CentralStockOrderCreatedByUser", fields: [createdBy], references: [id])
  approvedBy     String?
  approvedUser   User?                    @relation("CentralStockOrderApprovedByUser", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  status         CentralOrderStatus       @default(pending)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  loadedOrders   LoadedOrder[]
  events         CentralStockOrderEvent[]

  @@index([centralStockId])
  @@index([clearanceId])
}

/// What happened to a stock request and who did it: asked to be changed,
/// changed, approved, rejected, cancelled. The quantity either side of a
/// change is kept here, so the trail says what moved rather than only that
/// something did.
model CentralStockOrderEvent {
  id           String                  @id @default(uuid())
  orderId      String
  order        CentralStockOrder       @relation(fields: [orderId], references: [id])
  action       CentralStockOrderAction
  /// Why — the note the admin wrote when asking for a change, or the editor's
  /// own remark.
  comment      String?                 @db.Text
  fromQuantity Decimal?                @db.Decimal(18, 2)
  toQuantity   Decimal?                @db.Decimal(18, 2)
  actedBy      String
  user         User                    @relation("CentralStockOrderEventActor", fields: [actedBy], references: [id])
  createdAt    DateTime                @default(now())

  @@index([orderId])
  @@index([actedBy])
  @@index([createdAt])
}

enum CentralStockOrderAction {
  requested
  editRequested
  edited
  approved
  rejected
  cancelled
}

enum CentralStockOrderType {
  internal
  b2b
}

enum CentralOrderStatus {
  pending
  approved
  rejected
  cancelled
  /// Sent back to whoever raised it, to change the quantity. Only in this
  /// state may they edit it; saving returns it to `pending`. The reason and
  /// the figures either side are kept in `CentralStockOrderEvent`.
  editing
}

model TblSite {
  id                  String                @id @default(uuid())
