{
    "name": "petrox-backend",
    "version": "0.1.0",
    "private": true,
    "description": "Petrox Fastify API",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json && mkdir -p dist/src/shared/emails && cp -r src/shared/emails/templates dist/src/shared/emails/",
        "start": "node dist/src/server.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:seed": "tsx prisma/seed.ts",
        "prisma:seed:demo": "tsx prisma/seed.ts --demo",
        "backup:decrypt": "tsx scripts/decrypt-backup.ts",
        "phones:normalize": "tsx scripts/normalize-phones.ts",
        "fees:placement": "tsx scripts/landing-fee-placement.ts",
        "discounts:check": "tsx scripts/discount-check.ts",
        "rota:dates": "tsx --env-file=.env scripts/pump-rota-dates.ts",
        "postinstall": "prisma generate"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^11.1.0",
        "@fastify/helmet": "^13.0.1",
        "@fastify/jwt": "^10.0.0",
        "@fastify/multipart": "^10.1.0",
        "@fastify/rate-limit": "^11.0.0",
        "@fastify/static": "^10.1.3",
        "@prisma/client": "6.19.3",
        "bcryptjs": "^3.0.2",
        "dotenv": "^17.2.1",
        "ejs": "^6.0.1",
        "fastify": "^5.11.2",
        "fastify-plugin": "^5.0.1",
        "fastify-type-provider-zod": "^7.0.0",
        "pdfkit": "^0.20.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/ejs": "^3.1.5",
        "@types/node": "^24.2.0",
        "@types/pdfkit": "^0.17.7",
        "@types/supertest": "^6.0.3",
        "prisma": "6.19.3",
        "supertest": "^7.2.2",
        "tsx": "^4.20.3",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4"
    }
}
